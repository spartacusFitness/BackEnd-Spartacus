# Copia este archivo a `.env` y llena los valores reales.

# --- Base de datos: Supabase, pooler de SESIÓN (puerto 5432) ---
# No uses el pooler de transacciones (6543): Prisma 8 necesita conexión de sesión.
# Si la contraseña tiene símbolos, codifícalos en la URL (p. ej. "$" → %24).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-us-west-2.pooler.supabase.com:5432/postgres"

# --- Supabase (Project Settings → API Keys) ---
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""
# Solo backend. Nunca en el frontend.
SUPABASE_SECRET_KEY=""

# Orígenes del frontend, separados por coma (CORS)
FRONTEND_URL="http://localhost:5173,http://localhost:4173"

# Google se configura en Supabase: Authentication → Sign In / Providers → Google.
# Primera vez en un proyecto nuevo: ejecutar supabase/sql/001 y 002, luego
#   npx prisma db init  →  npm run build  →  npm run seed:sedes
